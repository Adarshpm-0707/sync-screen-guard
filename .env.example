# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://syncforall.com

# Frontend Vite Supabase Configurations (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
VITE_SUPABASE_ANON_KEY=sb_publishable_placeholder

# Backend Supabase Configurations (Private Server Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Payment Gateway Credentials
VITE_RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Fixed COD Handling Fee (0 for Free COD)
COD_FEE=0

# Supabase Database Direct Password (for migrations)
DB_PASSWORD=your_db_password

# Shiprocket Logistics Credentials
SHIPROCKET_EMAIL=your_shiprocket_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=warehouse
SHIPROCKET_CHANNEL_ID=your_channel_id
